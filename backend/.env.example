# Comma-separated browser origins allowed to call this API in development.
HASHLOG_CORS_ORIGINS=http://localhost:5173

# SQLite database location. Relative paths are resolved from backend/.
HASHLOG_DATABASE_PATH=hashlog.db

# Optional. When set, clients must send X-API-Key on API requests.
HASHLOG_API_KEY=

# Requests per client per minute in this API process.
HASHLOG_RATE_LIMIT_PER_MINUTE=120

# Development only: enables the UI Tamper Lab. Keep false in shared/production environments.
HASHLOG_ENABLE_TAMPER_TEST=true
